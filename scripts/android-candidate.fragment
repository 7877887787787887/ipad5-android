# Candidate Kconfig additions; not an Android compatibility certification.
CONFIG_SECURITY_SELINUX=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_CGROUP_BPF=y
CONFIG_CPUSETS=y
CONFIG_CPUSETS_V1=y
CONFIG_EROFS_FS=y
CONFIG_DM_VERITY=y
CONFIG_F2FS_FS=y
CONFIG_FS_ENCRYPTION=y
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
