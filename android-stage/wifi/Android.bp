cc_library_shared {
    name: "libwifi-hal-j72s",
    vendor: true,
    compile_multilib: "64",
    srcs: ["wifi_hal.cpp", "wifi_interface.cpp"],
    header_libs: ["wifi_legacy_headers"],
    shared_libs: ["libnl"],
    cpp_std: "c++17",
    cflags: ["-Wall", "-Wextra", "-Werror", "-fvisibility=hidden"],
}
