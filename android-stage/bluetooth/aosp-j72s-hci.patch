+void BluetoothHci::readPackets() {
+  pollfd fds[] = {{mStopFd, POLLIN, 0}, {mFd, POLLIN, 0}};
+  while (!mDisconnected) {
+    const int result = TEMP_FAILURE_RETRY(poll(fds, 2, -1));
+    if (fds[0].revents != 0) {
+      return;
+    }
+    if (result < 0 || (fds[1].revents & (POLLERR | POLLHUP | POLLNVAL))) {
+      break;
+    }
+    if (fds[1].revents & POLLIN) {
+      mH4->OnDataReady();
+    }
+  }
+  mDisconnected = true;
+  ALOGW("J72s Bluetooth HCI socket disconnected");
 }
 
