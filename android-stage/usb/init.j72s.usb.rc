# /config is mounted by Android's main init before post-fs.
on post-fs
    mkdir /config/usb_gadget/g1 0770 root root
    mkdir /config/usb_gadget/g1/strings/0x409 0770 root root
    write /config/usb_gadget/g1/bcdUSB 0x0200
    write /config/usb_gadget/g1/idVendor 0x18d1
    write /config/usb_gadget/g1/idProduct 0x4ee7
    write /config/usb_gadget/g1/strings/0x409/manufacturer Android
    write /config/usb_gadget/g1/strings/0x409/product "iPad 5 Android"
    write /config/usb_gadget/g1/strings/0x409/serialnumber ${ro.serialno}
    mkdir /config/usb_gadget/g1/functions/ffs.adb
    mkdir /config/usb_gadget/g1/configs/b.1 0770 root root
    mkdir /config/usb_gadget/g1/configs/b.1/strings/0x409 0770 root root

    mkdir /dev/usb-ffs 0775 shell shell
    mkdir /dev/usb-ffs/adb 0770 shell shell
    mount functionfs adb /dev/usb-ffs/adb nodev noexec nosuid rmode=0770,fmode=0660,uid=2000,gid=2000

    # Android's stock init binds this UDC after adbd signals readiness.
    setprop sys.usb.controller 20c100000.usbdev
    setprop sys.usb.configfs 1
