+static int adbe_init(struct driver *drv)
+{
+	/* Orchard ADBE only presents linear XRGB8888 on its primary plane. */
+	static const uint32_t formats[] = {
+		DRM_FORMAT_XRGB8888, DRM_FORMAT_ARGB8888, DRM_FORMAT_XBGR8888, DRM_FORMAT_ABGR8888,
+	};
+	drv_add_combinations(drv, formats, ARRAY_SIZE(formats), &LINEAR_METADATA,
+			     BO_USE_RENDER_MASK);
+	drv_modify_combination(drv, DRM_FORMAT_XRGB8888, &LINEAR_METADATA, BO_USE_SCANOUT);
+	return 0;
+}
+
+static void adbe_resolve_format(struct driver *drv, uint32_t format, uint64_t use_flags,
+				uint32_t *out_format, uint64_t *out_use_flags)
+{
+	drv_resolve_format_and_use_flags_helper(drv, format, use_flags, out_format, out_use_flags);
+	if (format == DRM_FORMAT_FLEX_IMPLEMENTATION_DEFINED &&
+	    !(use_flags & (BO_USE_CAMERA_READ | BO_USE_CAMERA_WRITE)) && (use_flags & BO_USE_SCANOUT))
+		*out_format = DRM_FORMAT_XRGB8888;
+}
+
+const struct backend backend_adbe = {
+	.name = "adbe",
+	.init = adbe_init,
+	.bo_create = drv_dumb_bo_create,
+	.bo_create_with_modifiers = dumb_bo_create_with_modifiers,
+	.bo_destroy = drv_dumb_bo_destroy,
+	.bo_import = drv_prime_bo_import,
+	.bo_map = drv_dumb_bo_map,
+	.bo_unmap = drv_bo_munmap,
+	.resolve_format_and_use_flags = adbe_resolve_format,
+};
